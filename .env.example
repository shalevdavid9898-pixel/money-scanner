# Server
NODE_ENV=development
PORT=3000
TZ=Asia/Jerusalem

# Database — local dev uses an embedded file, production points at a Turso libsql:// URL
DATABASE_URL=file:./data/money-scanner.db
TURSO_AUTH_TOKEN=

# LLM (server-side only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Auth (single-user personal app)
APP_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduled scan endpoint (called by cron-job.org, not the browser)
CRON_SECRET=change-me-to-a-long-random-string
